{
  "name": "pickle-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugogo/pickle-ui.git"
  },
  "scripts": {
    "dev": "pnpm --filter @pickle-ui/react dev",
    "dev:native": "pnpm --filter @pickle-ui/react-native dev",
    "build": "pnpm -r run build",
    "build-storybook": "pnpm -r run build-storybook",
    "example:web": "pnpm --filter @pickle-ui/example-web dev",
    "example:mobile": "pnpm --filter @pickle-ui/example-mobile start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "pnpm -r run doctor",
    "prepare": "husky",
    "changeset": "changeset"
  },
  "author": "Ugo Onali",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
